<?xml version="1.0" encoding="utf-8"?>
<!--
  Context definitions for Context Music Manager.
  This file is hot-reloaded — save while the game is running to apply changes.

  Attributes:
    name      - unique identifier (used in logs and fallback references)
    path      - subfolder under /Music, OR an absolute folder path anywhere on disk
                (e.g. path="D:\MyMusic\Ambient")  (empty = sentinel, no audio).
                Absolute-path folders still get loudness normalization + per-track volume.
    fallback  - what to try when this context has no files:
                  Stack             = check remaining active contexts by priority
                  VanillaIfDMS      = vanilla when Dynamic Music is on, else Stack
                  VanillaIfPanicked = vanilla when threat=Panicked, else Stack
                  Vanilla / Silence / <another context name>
    resume    - continue from where we left off when re-entering  (default: true)
    stale     - seconds before an abandoned resume position is forgotten  (0 = never resume)
    loop      - loop the clip rather than picking a new track on end
    cool      - seconds before this context can fire again after leaving
    fadeintime - fade-in duration in seconds (the crossfade ramp when this context's music starts)
    warmup    - seconds this context must remain CONTINUOUSLY active before it becomes
                eligible to trigger music  (0 = trigger immediately; an anti-flicker dwell
                so momentary contexts don't interrupt what's already playing)
    warmgroup - optional tag shared by contexts that hand off to each other (e.g. a
                day/night pair). When one joins while a group sibling is still active,
                it inherits the group's oldest warmup start instead of restarting its
                own — so a day↔night swap stays viable continuously instead of dropping
                out for the full warmup and letting a lower context play briefly. Each
                context still uses its OWN warmup value; keep group members' warmups
                equal for a predictable dwell.
    bypass    - skip cooldown check on entry  (use for stingers/events)
    priority  - higher value wins; equal priority never interrupts a playing context
    once      - play to completion then automatically return to previous context
    volume    - per-context volume multiplier (0.0–1.0) that replaces the global
                VolumeModifier for this context  (omit / negative = use global)
    subfolders - look for music in this folder AND all of its subfolders (default:
                false = only files sitting directly in the folder). If a subfolder is
                itself another context's path, the tracks there belong to that more
                specific context, not this one — so each track only ever plays in a
                single context and you never get the same song double-counted.
-->
<Contexts>

  <!-- ── Events ────────────────────────────────── -->
  <Context name="Death"                      path="events/death"                subfolders="false" fallback="Stack"             resume="false" stale="0"   loop="false" cool="3" fadeintime="1" warmup="0"  warmgroup=""     bypass="true"  priority="100" once="true"  volume="-1" />
  <Context name="Low_Health_Panic"           path="events/low_health"           subfolders="false" fallback="Stack"             resume="true"  stale="30"  loop="false" cool="5" fadeintime="2" warmup="0"  warmgroup=""     bypass="true"  priority="90"  once="false" volume="-1" />
  <Context name="Spawn"                      path="events/spawn"                subfolders="false" fallback="Stack"             resume="false" stale="0"   loop="false" cool="3" fadeintime="1" warmup="0"  warmgroup=""     bypass="true"  priority="45"  once="true"  volume="-1" />

  <!-- ── Vehicles ─────────────────────────────── -->
  <Context name="Vehicle_Gyrocopter"         path="vehicle/gyrocopter"          subfolders="false" fallback="Vehicle"           resume="true"  stale="30"  loop="false" cool="5" fadeintime="3" warmup="1"  warmgroup=""     bypass="true"  priority="70"  once="false" volume="-1" />
  <Context name="Vehicle_Bicycle"            path="vehicle/bicycle"             subfolders="false" fallback="Vehicle"           resume="true"  stale="30"  loop="false" cool="5" fadeintime="3" warmup="1"  warmgroup=""     bypass="true"  priority="70"  once="false" volume="-1" />
  <Context name="Vehicle_Minibike"           path="vehicle/minibike"            subfolders="false" fallback="Vehicle"           resume="true"  stale="30"  loop="false" cool="5" fadeintime="3" warmup="1"  warmgroup=""     bypass="true"  priority="70"  once="false" volume="-1" />
  <Context name="Vehicle_Motorcycle"         path="vehicle/motorcycle"          subfolders="false" fallback="Vehicle"           resume="true"  stale="30"  loop="false" cool="5" fadeintime="3" warmup="1"  warmgroup=""     bypass="true"  priority="70"  once="false" volume="-1" />
  <Context name="Vehicle_4x4"                path="vehicle/4x4"                 subfolders="false" fallback="Vehicle"           resume="true"  stale="30"  loop="false" cool="5" fadeintime="3" warmup="1"  warmgroup=""     bypass="true"  priority="70"  once="false" volume="-1" />
  <Context name="Vehicle"                    path="vehicle"                     subfolders="false" fallback="Stack"             resume="true"  stale="30"  loop="false" cool="5" fadeintime="3" warmup="1"  warmgroup=""     bypass="true"  priority="69"  once="false" volume="-1" />

  <!-- ── Swimming ─────────────────────────────── -->
  <!-- Player is in deep enough water to swim. 8s dwell so brief dips don't
       interrupt; falls back to the stack so exploration music resumes on exit. -->
  <Context name="Swimming"                   path="swimming"                    subfolders="false" fallback="Stack"             resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="5"  warmgroup=""     bypass="false" priority="23"  once="false" volume="-1" />

  <!-- ── Points of Interest ───────────────────── -->
  <!-- POI_Cleared fires once when the last sleeper in a POI is killed. Priority must
       outrank lingering combat: clearing a POI means you were just fighting, so combat
       (generic 50-52 AND biome 60-62) is still on the stack during the brief eviction
       window. At 91 the stinger wins over all combat tiers, Blood_Moon (71), and
       Low_Health_Panic (90); only Death (100) supersedes it. -->
  <Context name="POI_Cleared"                path="events/poi_cleared"          subfolders="false" fallback="Stack"             resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="0"  warmgroup=""     bypass="true"  priority="91"  once="true"  volume="1.0" />

  <!-- Infested and non-infested POI contexts share warmgroup="poi" so the clear handoff
       (POI_Infested_Tn -> POI_Tn) is continuous: the joining non-infested context inherits
       the group's oldest warmup start instead of restarting its own dwell, so it's viable
       immediately and ambient never leaks through the gap while the POI_Cleared stinger
       fades. Each context still uses its own warmup value. -->

  <!-- Infested: playing while sleeper volumes still hold live enemies. -->
  <Context name="POI_Infested_T5"            path="poi/infested/t5"             subfolders="false" fallback="POI_Infested"      resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="10" warmgroup="poi"  bypass="false" priority="22"  once="false" volume="-1" />
  <Context name="POI_Infested_T4"            path="poi/infested/t4"             subfolders="false" fallback="POI_Infested"      resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="10" warmgroup="poi"  bypass="false" priority="22"  once="false" volume="-1" />
  <Context name="POI_Infested_T3"            path="poi/infested/t3"             subfolders="false" fallback="POI_Infested"      resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="10" warmgroup="poi"  bypass="false" priority="22"  once="false" volume="-1" />
  <Context name="POI_Infested_T2"            path="poi/infested/t2"             subfolders="false" fallback="POI_Infested"      resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="10" warmgroup="poi"  bypass="false" priority="22"  once="false" volume="-1" />
  <Context name="POI_Infested_T1"            path="poi/infested/t1"             subfolders="false" fallback="POI_Infested"      resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="10" warmgroup="poi"  bypass="false" priority="22"  once="false" volume="-1" />
  <Context name="POI_Infested_T0"            path="poi/infested/t0"             subfolders="false" fallback="Stack"             resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="10" warmgroup="poi"  bypass="false" priority="21"  once="false" volume="-1" />
  <Context name="POI_Infested"               path="poi/infested"                subfolders="false" fallback="Stack"             resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="10" warmgroup="poi"  bypass="false" priority="20"  once="false" volume="-1" />

  <!-- Non-infested: inside a POI with no live sleepers (cleared or never infested). -->
  <Context name="POI_T5"                     path="poi/t5"                      subfolders="false" fallback="POI"               resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="5"  warmgroup="poi"  bypass="false" priority="18"  once="false" volume="-1" />
  <Context name="POI_T4"                     path="poi/t4"                      subfolders="false" fallback="POI"               resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="5"  warmgroup="poi"  bypass="false" priority="18"  once="false" volume="-1" />
  <Context name="POI_T3"                     path="poi/t3"                      subfolders="false" fallback="POI"               resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="5"  warmgroup="poi"  bypass="false" priority="18"  once="false" volume="-1" />
  <Context name="POI_T2"                     path="poi/t2"                      subfolders="false" fallback="POI"               resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="5"  warmgroup="poi"  bypass="false" priority="18"  once="false" volume="-1" />
  <Context name="POI_T1"                     path="poi/t1"                      subfolders="false" fallback="POI"               resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="5"  warmgroup="poi"  bypass="false" priority="18"  once="false" volume="-1" />
  <Context name="POI_T0"                     path="poi/t0"                      subfolders="false" fallback="Stack"             resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="5"  warmgroup="poi"  bypass="false" priority="17"  once="false" volume="-1" />
  <Context name="POI"                        path="poi"                         subfolders="false" fallback="Stack"             resume="true"  stale="60"  loop="false" cool="5" fadeintime="5" warmup="5"  warmgroup="poi"  bypass="false" priority="16"  once="false" volume="-1" />

  <!-- ── Combat ──────────────────────────────────── -->
  <!-- Three combat tiers selected by the <CombatThreat> model in settings.xml. The
       combat/ root folder IS the base (low) tier; the escalations live in its _high and
       _boss subfolders, underscore-prefixed so the directory scan never confuses them with
       the per-biome subfolders below. Boss → High → Low; Low bridges to vanilla combat
       music (when DMS is on and the game threat is Panicked). Folder scanning is top-level
       only, so combat/ (Low) does NOT pick up files sitting in _high / _boss / <biome>. -->
  <!-- Blood_Moon_Combat: combat during a blood moon night (highest combat priority). -->
  <Context name="Blood_Moon_Combat"          path="combat/blood_moon"           subfolders="false" fallback="Combat_Boss"       resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="71"  once="false" volume="-1" />
  <Context name="Combat_Boss"                path="combat/_boss"                subfolders="false" fallback="Combat_High"       resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="52"  once="false" volume="-1" />
  <Context name="Combat_High"                path="combat/_high"                subfolders="false" fallback="Combat_Low"        resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="51"  once="false" volume="-1" />
  <Context name="Combat_Low"                 path="combat"                      subfolders="false" fallback="VanillaIfPanicked" resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="50"  once="false" volume="-1" />

  <!-- Biome-specific combat tiers. Each biome gets a combat/<biome> folder that mirrors
       the generic layout: the biome folder root is that biome's low tier, with _high and
       _boss subfolders for escalation. The resolver puts the biome variant on the stack
       alongside the active generic tier whenever combat fires in a known biome (e.g.
       Combat_High + Combat_High_Forest). Each variant outranks its generic counterpart
       (priority band 60–62) so biome combat music wins when its folder has tracks, and
       falls back to the matching generic tier when the folder is empty. Only the one active
       tier gets a variant on the stack, so the band never inverts across tiers.
       Blood_Moon_Combat stays generic (no biome split). Empty folders are intentional:
       ship only the biome/tier combinations you have music for. -->
  <!-- Burnt forest -->
  <Context name="Combat_Boss_Burnt_Forest"   path="combat/burnt_forest/_boss"   subfolders="false" fallback="Combat_Boss"       resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="62"  once="false" volume="-1" />
  <Context name="Combat_High_Burnt_Forest"   path="combat/burnt_forest/_high"   subfolders="false" fallback="Combat_High"       resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="61"  once="false" volume="-1" />
  <Context name="Combat_Low_Burnt_Forest"    path="combat/burnt_forest"         subfolders="false" fallback="Combat_Low"        resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="60"  once="false" volume="-1" />
  <!-- Desert -->
  <Context name="Combat_Boss_Desert"         path="combat/desert/_boss"         subfolders="false" fallback="Combat_Boss"       resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="62"  once="false" volume="-1" />
  <Context name="Combat_High_Desert"         path="combat/desert/_high"         subfolders="false" fallback="Combat_High"       resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="61"  once="false" volume="-1" />
  <Context name="Combat_Low_Desert"          path="combat/desert"               subfolders="false" fallback="Combat_Low"        resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="60"  once="false" volume="-1" />
  <!-- Forest -->
  <Context name="Combat_Boss_Forest"         path="combat/forest/_boss"         subfolders="false" fallback="Combat_Boss"       resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="62"  once="false" volume="-1" />
  <Context name="Combat_High_Forest"         path="combat/forest/_high"         subfolders="false" fallback="Combat_High"       resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="61"  once="false" volume="-1" />
  <Context name="Combat_Low_Forest"          path="combat/forest"               subfolders="false" fallback="Combat_Low"        resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="60"  once="false" volume="-1" />
  <!-- Snow -->
  <Context name="Combat_Boss_Snow"           path="combat/snow/_boss"           subfolders="false" fallback="Combat_Boss"       resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="62"  once="false" volume="-1" />
  <Context name="Combat_High_Snow"           path="combat/snow/_high"           subfolders="false" fallback="Combat_High"       resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="61"  once="false" volume="-1" />
  <Context name="Combat_Low_Snow"            path="combat/snow"                 subfolders="false" fallback="Combat_Low"        resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="60"  once="false" volume="-1" />
  <!-- Wasteland -->
  <Context name="Combat_Boss_Wasteland"      path="combat/wasteland/_boss"      subfolders="false" fallback="Combat_Boss"       resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="62"  once="false" volume="-1" />
  <Context name="Combat_High_Wasteland"      path="combat/wasteland/_high"      subfolders="false" fallback="Combat_High"       resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="61"  once="false" volume="-1" />
  <Context name="Combat_Low_Wasteland"       path="combat/wasteland"            subfolders="false" fallback="Combat_Low"        resume="true"  stale="20"  loop="false" cool="3" fadeintime="3" warmup="0"  warmgroup=""     bypass="true"  priority="60"  once="false" volume="-1" />

  <!-- ── Tension ─────────────────────────────────── -->
  <Context name="Tension"                    path="tension"                     subfolders="false" fallback="Stack"             resume="true"  stale="30"  loop="false" cool="5" fadeintime="5" warmup="2"  warmgroup=""     bypass="false" priority="30"  once="false" volume="-1" />

  <!-- ── Traders ─────────────────────────────────── -->
  <Context name="Trader_Joel"                path="trader/joel"                 subfolders="false" fallback="Trader"            resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="3"  warmgroup=""     bypass="false" priority="26"  once="false" volume="-1" />
  <Context name="Trader_Jen"                 path="trader/jen"                  subfolders="false" fallback="Trader"            resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="3"  warmgroup=""     bypass="false" priority="26"  once="false" volume="-1" />
  <Context name="Trader_Rekt"                path="trader/rekt"                 subfolders="false" fallback="Trader"            resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="3"  warmgroup=""     bypass="false" priority="26"  once="false" volume="-1" />
  <Context name="Trader_Bob"                 path="trader/bob"                  subfolders="false" fallback="Trader"            resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="3"  warmgroup=""     bypass="false" priority="26"  once="false" volume="-1" />
  <Context name="Trader_Hugh"                path="trader/hugh"                 subfolders="false" fallback="Trader"            resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="3"  warmgroup=""     bypass="false" priority="26"  once="false" volume="-1" />
  <Context name="Trader"                     path="trader"                      subfolders="false" fallback="VanillaIfDMS"      resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="3"  warmgroup=""     bypass="false" priority="25"  once="false" volume="-1" />

  <!-- ── Home ──────────────────────────────────────── -->
  <!-- Home plays by day (and is the default); Home_Night provides night-exclusive
       tracks and falls back to Home when it has no files. -->
  <Context name="Home_Night"                 path="home/night"                  subfolders="false" fallback="Home"              resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="5"  warmgroup="home" bypass="false" priority="15"  once="false" volume="-1" />
  <Context name="Home"                       path="home"                        subfolders="false" fallback="Stack"             resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="5"  warmgroup="home" bypass="false" priority="15"  once="false" volume="-1" />

  <!-- ── Ambient ─────────────────────────────────── -->
  <!-- The biome base plays by day (and is the everyday default); each biome's
       optional _Night context (in a _night subfolder) provides night-exclusive tracks.
       Night fallback order: biome _Night -> generic Ambient_Night -> (Stack) the biome's
       OWN day theme -> generic Ambient. The day theme is reachable because the resolver
       also puts the biome day context on the stack at night, and Ambient_Night falls back
       to Stack to find it. Biome _Night is priority 12 (above the day context, 11) so the
       night theme wins whenever it has tracks. -->
  <Context name="Ambient_Forest_Night"       path="ambient/forest/_night"       subfolders="false" fallback="Ambient_Night"     resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="0"  warmgroup=""     bypass="false" priority="12"  once="false" volume="-1" />
  <Context name="Ambient_Forest"             path="ambient/forest"              subfolders="false" fallback="Ambient"           resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="0"  warmgroup=""     bypass="false" priority="11"  once="false" volume="-1" />
  <Context name="Ambient_Burnt_Forest_Night" path="ambient/burnt_forest/_night" subfolders="false" fallback="Ambient_Night"     resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="0"  warmgroup=""     bypass="false" priority="12"  once="false" volume="-1" />
  <Context name="Ambient_Burnt_Forest"       path="ambient/burnt_forest"        subfolders="false" fallback="Ambient"           resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="0"  warmgroup=""     bypass="false" priority="11"  once="false" volume="-1" />
  <Context name="Ambient_Desert_Night"       path="ambient/desert/_night"       subfolders="false" fallback="Ambient_Night"     resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="0"  warmgroup=""     bypass="false" priority="12"  once="false" volume="-1" />
  <Context name="Ambient_Desert"             path="ambient/desert"              subfolders="false" fallback="Ambient"           resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="0"  warmgroup=""     bypass="false" priority="11"  once="false" volume="-1" />
  <Context name="Ambient_Snow_Night"         path="ambient/snow/_night"         subfolders="false" fallback="Ambient_Night"     resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="0"  warmgroup=""     bypass="false" priority="12"  once="false" volume="-1" />
  <Context name="Ambient_Snow"               path="ambient/snow"                subfolders="false" fallback="Ambient"           resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="0"  warmgroup=""     bypass="false" priority="11"  once="false" volume="-1" />
  <Context name="Ambient_Wasteland_Night"    path="ambient/wasteland/_night"    subfolders="false" fallback="Ambient_Night"     resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="0"  warmgroup=""     bypass="false" priority="12"  once="false" volume="-1" />
  <Context name="Ambient_Wasteland"          path="ambient/wasteland"           subfolders="false" fallback="Ambient"           resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="0"  warmgroup=""     bypass="false" priority="11"  once="false" volume="-1" />
  <Context name="Ambient_Night"              path="ambient/_night"              subfolders="false" fallback="Stack"             resume="true"  stale="120" loop="false" cool="5" fadeintime="5" warmup="0"  warmgroup=""     bypass="false" priority="11"  once="false" volume="-1" />
  <Context name="Ambient"                    path="ambient"                     subfolders="false" fallback="VanillaIfDMS"      resume="true"  stale="120" loop="false" cool="5" fadeintime="4" warmup="0"  warmgroup=""     bypass="false" priority="10"  once="false" volume="-1" />

  <!-- ── Menu ──────────────────────────────────────── -->
  <Context name="Menu"                       path="menu"                        subfolders="false" fallback="Vanilla"           resume="false" stale="0"   loop="false" cool="5" fadeintime="2" warmup="0"  warmgroup=""     bypass="true"  priority="0"   once="false" volume="-1" />

