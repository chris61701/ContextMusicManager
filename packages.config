<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!-- All managed audio codec packages (NAudio + sub-assemblies, Concentus,
       Concentus.Oggfile, CSCore, NVorbis, NAudio.Vorbis) and their transitive
       shim deps (System.Memory/Buffers/Numerics.Vectors/Runtime.CompilerServices.Unsafe/
       Resources.Extensions/Security.AccessControl/Security.Principal.Windows/ValueTuple,
       Microsoft.Win32.Registry) removed: every format decodes natively in CMM_Decoder.dll,
       the WaveStream/WaveFormat base types live in-repo (Harmony/WaveShim.cs), and an
       assembly-ref dump confirmed none of those shims are referenced by the built DLLs. -->
  <package id="MoonSharp" version="2.0.0" targetFramework="net481" />
</packages>
