<Project Sdk="Microsoft.NET.Sdk">

  <!-- ───────────────────────────────────────────────────────────────────────
       CmmLoudnessTest — progressive loudness measurement and the provisional-
       reading policy that surrounds it.

       LINKS the shipped LoudnessStore / AudioDecoder / NativeAudio (the same trick
       CmmBench and CmmResumeTest use) so these cases exercise the real gain rules
       and the real decode path, not a reimplementation. That matters more here than
       usual: the whole point of a partial reading is that it is used BEFORE it is
       correct, so every guard around it — the boost cap, the refusal to satisfy
       HasCurrent, the refusal to reach disk, the refusal to overwrite a finished
       reading — is load-bearing, and none of it is visible by playing the game for
       the two seconds it exists.

       Half the suite is pure policy and runs anywhere. The other half decodes REAL
       FILES, so it needs a corpus: pass a directory (or files) as arguments, or set
       CMM_TEST_MUSIC. With no corpus those cases SKIP rather than silently pass.

         dotnet run (project tools/CmmLoudnessTest) -c Release, then a dir or files
       Exit code 0 = all cases pass, 1 = at least one failed.
  ─────────────────────────────────────────────────────────────────────────── -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CmmLoudnessTest</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The linked decoder is platform-specific (native CMM_Decoder.dll, Windows x64). -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Harmony\LoudnessStore.cs" Link="linked\LoudnessStore.cs" />
    <Compile Include="..\..\Harmony\AudioDecoder.cs"  Link="linked\AudioDecoder.cs" />
    <Compile Include="..\..\Harmony\NativeAudio.cs"   Link="linked\NativeAudio.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\CMM_Decoder\dist\CMM_Decoder.dll" Link="CMM_Decoder.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
