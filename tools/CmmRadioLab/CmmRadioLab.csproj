<Project Sdk="Microsoft.NET.Sdk">

  <!-- ───────────────────────────────────────────────────────────────────────
       CmmRadioLab — the station-change tuning bench, with a UI.

       Renders a dial press two ways and lets you A/B them:

         GAME      via CmmRadioSim, which drives the shipping CMM_Decoder.dll
                   (real mixer, real receiver, real voice lifecycle, real
                   decoders) headless and captures the bus.
         REFERENCE via CmmTuneRender, the offline model whose output was
                   approved by ear.

       Those two agreeing IS the acceptance test. When they disagree, the
       difference is a real defect in the game path, and it can be found in
       seconds instead of by reloading a world.

       Every knob maps 1:1 onto a Radio* key in Config\radio.xml. Load reads a
       live install and REPORTS EVERY VALUE THAT DIFFERS from the shipped
       default — the check whose absence sent six weeks of in-game listening to
       numbers nobody had approved. Save writes back in place.

       Both child tools are separate processes on purpose: the native mixer is
       a process-wide singleton with its own producer thread, so keeping it out
       of the UI process means a wedged render cannot take the window with it.
  ─────────────────────────────────────────────────────────────────────────── -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CmmRadioLab</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
