<Project Sdk="Microsoft.NET.Sdk">

  <!-- ───────────────────────────────────────────────────────────────────────
       CmmScheduleTest — the radio broadcast schedule and its length cache.

       LINKS the shipped RadioStationCatalog rather than modelling it. That is the
       whole point: the schedule is what makes every client hear the same thing at
       the same moment, so a reimplementation would agree with itself and prove
       nothing. Everything under test here — ResolveAt, the anchor maths, the chain
       walk, ProbeLength's stamping, PoisonTrack, ForgetDeadLengths — is pure BCL.

       Only two methods in that file touch the game (BroadcastSeconds and
       EnsureCatalog's throttle), and neither is needed: ResolveAt takes the
       broadcast second as a PARAMETER, so the harness supplies its own clock and
       the schedule is testable with no change to shipped code at all.

         dotnet run (project tools/CmmScheduleTest) -c Release
       Exit code 0 = all cases pass, 1 = at least one failed.
  ─────────────────────────────────────────────────────────────────────────── -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CmmScheduleTest</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The linked decoder is platform-specific (native CMM_Decoder.dll, Windows x64). -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- GV_V3 deliberately NOT defined: that excludes the one emitter call-out
         (EmitterAudioLayer.OnCatalogRebuilt) from the linked catalog. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Harmony\RadioStationCatalog.cs" Link="linked\RadioStationCatalog.cs" />
    <Compile Include="..\..\Harmony\EmitterSlots.cs"        Link="linked\EmitterSlots.cs" />
    <Compile Include="..\..\Harmony\RadioDial.cs"        Link="linked\RadioDial.cs" />
    <Compile Include="..\..\Harmony\DataStructures.cs"     Link="linked\DataStructures.cs" />
    <Compile Include="..\..\Harmony\TrackRotation.cs"      Link="linked\TrackRotation.cs" />
    <Compile Include="..\..\Harmony\PlaylistSource.cs"      Link="linked\PlaylistSource.cs" />
    <Compile Include="..\..\Harmony\SourceScan.cs"          Link="linked\SourceScan.cs" />
    <Compile Include="..\..\Harmony\MusicRoots.cs"          Link="linked\MusicRoots.cs" />
    <Compile Include="..\..\Harmony\AudioDecoder.cs"        Link="linked\AudioDecoder.cs" />
    <Compile Include="..\..\Harmony\NativeAudio.cs"         Link="linked\NativeAudio.cs" />
    <Compile Include="..\..\Harmony\LoudnessStore.cs"       Link="linked\LoudnessStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\CMM_Decoder\dist\CMM_Decoder.dll" Link="CMM_Decoder.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
