<Project Sdk="Microsoft.NET.Sdk">

  <!-- ───────────────────────────────────────────────────────────────────────
       CmmResumeTest — edge-case table for "pick up where I left off".

       LINKS Harmony/ResumePolicy.cs directly (the same trick CmmConfigTest uses on
       CMMSettingsSchema.cs) so these cases exercise the SHIPPED functions, not a
       reimplementation. That is the whole point: the rules used to live inline in
       ContextMusicManager.AudioPlayer.cs, which imports UnityEngine and so can never be
       linked into a test, and the personal radio violated both of them for as long as
       the radio has existed, with nothing able to catch it but playing the game.

         dotnet run (project tools/CmmResumeTest) -c Release
       Exit code 0 = all cases pass, 1 = at least one failed.
  ─────────────────────────────────────────────────────────────────────────── -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CmmResumeTest</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Harmony\ResumePolicy.cs" Link="linked\ResumePolicy.cs" />
  </ItemGroup>

</Project>
