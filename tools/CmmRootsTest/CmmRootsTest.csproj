<Project Sdk="Microsoft.NET.Sdk">

  <!-- ───────────────────────────────────────────────────────────────────────
       CmmRootsTest — the add-on music folder harness.

       Builds a real filesystem: one primary music folder plus 30 mod-style packs
       with music scattered across them, duplicated, hidden in subfolders, listed
       in playlists, and missing entirely. Then runs the REAL resolution and
       enumeration over it and asserts every case.

       LINKS the shipping code — MusicRoots, SourceScan, PlaylistSource,
       AudioDecoder, DataStructures — so what is asserted is what the game does.
       This project exists because the older harnesses did NOT: they hand-ported
       the scan logic and had already drifted from it, which made every green run
       meaningless. Nothing here is a copy.

       Shims.cs supplies only Log / CMMConfig.D / the UnityEngine stand-ins the
       linked files reference.
  ─────────────────────────────────────────────────────────────────────────── -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CmmRootsTest</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Env.cs" />
    <Compile Include="Shims.cs" />
    <Compile Include="..\..\Harmony\MusicRoots.cs"     Link="linked\MusicRoots.cs" />
    <Compile Include="..\..\Harmony\SourceScan.cs"     Link="linked\SourceScan.cs" />
    <Compile Include="..\..\Harmony\PlaylistSource.cs" Link="linked\PlaylistSource.cs" />
    <Compile Include="..\..\Harmony\AudioDecoder.cs"   Link="linked\AudioDecoder.cs" />
    <Compile Include="..\..\Harmony\NativeAudio.cs"    Link="linked\NativeAudio.cs" />
    <Compile Include="..\..\Harmony\DataStructures.cs" Link="linked\DataStructures.cs" />
    <Compile Include="..\..\Harmony\TrackRotation.cs" Link="linked\TrackRotation.cs" />
  </ItemGroup>

  <!-- Never decoded here (IsSupported is pure managed), but present so a stray
       DllImport resolves rather than throwing. -->
  <ItemGroup>
    <Content Include="..\..\CMM_Decoder\dist\CMM_Decoder.dll" Link="CMM_Decoder.dll"
             Condition="Exists('..\..\CMM_Decoder\dist\CMM_Decoder.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
