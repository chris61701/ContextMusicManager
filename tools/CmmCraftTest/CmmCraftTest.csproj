<Project Sdk="Microsoft.NET.Sdk">

  <!--
       CmmCraftTest . the craftable-recipe gate, against a fake game that behaves like
       the real one where it matters.

       The bug it exists to keep fixed: the game RELOADS its recipe list on every world
       load, and CraftingGate set a flag once and never looked again, so the ham radio
       and speaker were craftable on the first world after launching and on no world
       after that, for the rest of the session. Nothing in the log said so, because
       "2 recipes offered" was true when it was printed.

       Reasoning about that is what produced the bug. This reproduces it: the fake
       CraftingManager empties its list and reassigns block ids exactly as a world load
       does, and the assertions are about what a player would find in the crafting
       window afterwards.

       WHAT IS REAL: CraftingGate.cs entire, including its Harmony AccessTools bind.
       WHAT IS NOT: the game. ItemClass, Recipe, CraftingManager, Block and
       ConnectionManager are fakes whose whole job is to be reassignable on demand.

         dotnet run (project tools/CmmCraftTest) -c Release
       Exit code 0 = every case held.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CmmCraftTest</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Harmony\CraftingGate.cs" Link="linked\CraftingGate.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>C:\_Games\Steam\steamapps\common\7 Days To Die\Mods\0_TFP_Harmony\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
