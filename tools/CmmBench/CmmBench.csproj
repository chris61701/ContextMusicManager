<Project Sdk="Microsoft.NET.Sdk">

  <!-- ───────────────────────────────────────────────────────────────────────
       CmmBench — standalone decode/loudness micro-benchmark (Arena B).

       Runs the mod's REAL decode + EBU R128 measurement pipeline outside the
       game so the CPU-bound pieces (AudioDecoder.MeasureLoudness / the bare
       native-handle open) can be profiled and optimized with a fast measure-edit
       loop, with no Unity launch. It LINKS the actual source files (no copy to
       drift) and supplies thin shims (Shims.cs) for the handful of non-audio
       symbols the decoder touches (CMMConfig / Log / LoudnessStore.HashFile / Mathf).

       Build and run with dotnet against tools/CmmBench in Release; pass a
       directory or files plus the flags documented in Program.cs.
  ─────────────────────────────────────────────────────────────────────────── -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CmmBench</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The linked decoder is platform-specific (native CMM_Decoder.dll, Windows x64). -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- The mod's real source, linked so the bench can never drift from shipped code. -->
  <ItemGroup>
    <Compile Include="..\..\Harmony\AudioDecoder.cs"   Link="linked\AudioDecoder.cs" />
    <Compile Include="..\..\Harmony\NativeAudio.cs"     Link="linked\NativeAudio.cs" />
  </ItemGroup>

  <!-- Native decode shim — copied next to the exe so DllImport("CMM_Decoder") resolves. -->
  <ItemGroup>
    <Content Include="..\..\CMM_Decoder\dist\CMM_Decoder.dll" Link="CMM_Decoder.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- No managed audio packages at all: every format decodes natively in
       CMM_Decoder.dll (copied next to the exe above) and the WaveStream/WaveFormat
       base types come from the linked Harmony/WaveShim.cs. NAudio is gone. -->

</Project>
