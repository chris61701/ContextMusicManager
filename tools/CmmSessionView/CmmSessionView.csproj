<Project Sdk="Microsoft.NET.Sdk">

  <!-- ───────────────────────────────────────────────────────────────────────
       CmmSessionView — top-down game-style VISUALIZER over the CmmSession harness.

       Drives the SAME SessionRunner the console bench uses (tools/CmmSession/
       SessionRunner.cs, linked below — one code path, no drift) and renders the live
       session as a top-down board + HUD with GDI+. Two speed modes:
         • real-time — paced 1:1 to the wall clock, the native mixer actually PLAYS.
         • max       — free-runs the sim (decode gated off, muted) to blitz the arc.

       Dev tool only — never part of the game deploy (like the other tools/).
  ─────────────────────────────────────────────────────────────────────────── -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CmmSessionView</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The linked decoder + mixer are platform-specific (native CMM_Decoder.dll, Windows x64). -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- The shared session harness (drives the real engine; identical to the bench's path). -->
  <ItemGroup>
    <Compile Include="..\CmmSession\SessionRunner.cs" Link="linked\SessionRunner.cs" />
    <Compile Include="..\CmmSession\Engine.cs"        Link="linked\Engine.cs" />
    <Compile Include="..\CmmSession\Session.cs"       Link="linked\Session.cs" />
    <Compile Include="..\CmmSession\Emitter.cs"       Link="linked\Emitter.cs" />
    <Compile Include="..\CmmSession\ReloadHarness.cs" Link="linked\ReloadHarness.cs" />
    <Compile Include="..\CmmSession\Shims.cs"         Link="linked\Shims.cs" />
  </ItemGroup>

  <!-- The mod's real source, linked so the viewer can never drift from shipped code. -->
  <ItemGroup>
    <Compile Include="..\..\Harmony\DataStructures.cs" Link="linked\DataStructures.cs" />
    <Compile Include="..\..\Harmony\GameState.cs"      Link="linked\GameState.cs" />
    <Compile Include="..\..\Harmony\ScriptHost.cs"     Link="linked\ScriptHost.cs" />
    <Compile Include="..\..\Harmony\AudioDecoder.cs"   Link="linked\AudioDecoder.cs" />
    <Compile Include="..\..\Harmony\NativeAudio.cs"    Link="linked\NativeAudio.cs" />
    <Compile Include="..\..\Harmony\CmmMixer.cs"       Link="linked\CmmMixer.cs" />
  </ItemGroup>

  <!-- MoonSharp: pure-managed Lua interpreter hosting context.lua (same DLL the mod ships). -->
  <ItemGroup>
    <Reference Include="MoonSharp.Interpreter">
      <HintPath>..\..\packages\MoonSharp.2.0.0\lib\net40-client\MoonSharp.Interpreter.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Canonical default context.lua, embedded under the same logical name the mod uses. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Config\context.lua">
      <LogicalName>context.lua</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Native decode shim — copied next to the exe so DllImport("CMM_Decoder") resolves. -->
  <ItemGroup>
    <Content Include="..\..\CMM_Decoder\dist\CMM_Decoder.dll" Link="CMM_Decoder.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
