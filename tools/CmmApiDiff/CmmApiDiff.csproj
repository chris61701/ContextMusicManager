<Project Sdk="Microsoft.NET.Sdk">

  <!-- ───────────────────────────────────────────────────────────────────────
       CmmApiDiff — every game member the built mod REFERENCES, checked against
       another version's assembly.

       Written after missing a cross-version divergence four times in a row on one
       feature, each time through the gap the previous hand-survey left: name only,
       then declaring type, then signature, then a type I had not thought to check.
       Grepping decompiled source asks "did I think to look here". This asks the DLL
       what it actually calls, which is not a matter of opinion.

         dotnet run (project tools/CmmApiDiff) -c Release, then mod.dll and each game's Assembly-CSharp.dll
       Exit code 0 = every referenced member exists in the target assembly.
  ─────────────────────────────────────────────────────────────────────────── -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CmmApiDiff</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.Metadata" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="allowed-missing.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
