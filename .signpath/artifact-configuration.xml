<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "cmm-decoder" (paste into the SignPath project when it is
     set up; kept here so the rule is reviewed with the code). The build uploads a zip holding
     CMM_Decoder.dll; only that DLL is signed, and only if its version resource names this
     product, so a stray or foreign binary cannot get our signature. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="CMM_Decoder.dll" product-name="Context Music Manager" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
