      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition=" '$(Configuration)' != 'CI' ">
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyHintPath)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- ALL managed audio decoders removed (NAudio + Concentus/CSCore/NVorbis):
         every format now decodes natively in CMM_Decoder.dll (libopusfile /
         libvorbisfile / dr_flac / dr_mp3 / dr_wav), and the WaveStream/WaveFormat
         base types live in-repo (Harmony/WaveShim.cs). -->
    <Reference Include="LogLibrary">
      <HintPath>$(GameManagedDir)\LogLibrary.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- MoonSharp: pure-managed Lua interpreter hosting the external context.lua
         decision script (see ScriptHost). net40-client build for Unity/Mono; copied
         to the mod ROOT (no Private=False) so it ships with the mod. It MUST stay at
         root, NOT Libs\: the game discovers our IModApi by scanning/loading every type
         (Mod.InitModCode → IsAssignableFrom over GetTypes()), which loads ScriptHost
         whose `_script` field is a MoonSharp type — resolving MoonSharp before any of
         our code runs, so no AssemblyResolve hook can be early enough (see HarmonyPatches). -->
    <Reference Include="MoonSharp.Interpreter">
      <HintPath>packages\MoonSharp.2.0.0\lib\net40-client\MoonSharp.Interpreter.dll</HintPath>
    </Reference>
    <!-- NAudio (all 8 sub-assemblies) and its transitive deps REMOVED. Assembly-ref
         analysis of the built ContextMusicManager.dll/MoonSharp.Interpreter.dll showed
         NONE of the old NuGet shims (System.Memory/Buffers/Numerics.Vectors/
         Runtime.CompilerServices.Unsafe/Resources.Extensions/Security.*/ValueTuple,
         Microsoft.Win32.Registry) are referenced — they were pure NAudio leftovers.
         ValueTuple resolves from mscorlib (net48 type-forwarding). -->
    <Reference Include="System">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Xml">
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Collider, for reading a door leaf's real bounds off its spawned prefab. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
