  </ItemGroup>
  <ItemGroup>
    <Folder Include="Patches\" />
  </ItemGroup>
  <ItemGroup>
    <Analyzer Include="$(GameManagedDir)\UnityEngine.InputModule.dll" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include="packages.config" />
    <None Include="README.md" />
