<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{90A1B09C-9B78-4C0B-88B1-4928F311D376}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>ContextMusicManager</RootNamespace>
    <AssemblyName>ContextMusicManager</AssemblyName>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <!-- Off: this is a mod DLL loaded into the game's process, and .NET only honors
         binding redirects from the host .exe's config — a ContextMusicManager.dll.config
         is ignored at runtime, so don't generate one. -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <!-- Don't copy reference-related files (e.g. dependency .xml doc files) to the output dir.
         Content items like ModInfo.xml are unaffected. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <GamePath>..\..\..\..\Steam\steamapps\common\7 Days To Die</GamePath>
    <ModsPath>..\..\..\..\vortex_udf_7_days_to_die\Mods</ModsPath>
    <TargetFrameworkProfile />
  </PropertyGroup>

  <!-- ── Target game version ─────────────────────────────────────────────
       Select which installed game version to build/deploy against:
         msbuild -p:GameVersion="2.6 b12"
       Defaults to the current release. Version-specific BUILD INPUTS (game-assembly
       HintPaths, the deploy Mods folder, and a GV_* compile symbol) derive from this
       one property. NOTE: the Release OUTPUT is a SINGLE cross-version zip — one
       compiled DLL runs on every supported game version (API divergences bridged by
       reflection; ModInfo.xml is dual-format), so neither the staging folder nor the
       zip name encodes a version. Add a version by copying a block below. -->
  <PropertyGroup>
    <GameVersion Condition="'$(GameVersion)' == ''">3.2.0 b9</GameVersion>
    <!-- Debug builds rewrite MusicPath in the deployed build/settings.dev.xml (the dev
         override file at the front of CMM's settings chain) to this; override with
         -p:DebugMusicPath=... . Release ships no settings file at all — CMM generates one
         on first run with the built-in default ("Music"). -->
    <DebugMusicPath Condition="'$(DebugMusicPath)' == ''">J:\7D2D Custom Music</DebugMusicPath>
    <!-- A plain Debug build (including the VS Build button, which never passes a target)
         fans out to EVERY game install via the DebugFanout target below, so all four
         Mods folders stay in sync. Override with -p:CMMDeployAll=false for a quick
         single-version build into just the selected GameVersion's install. Always false
         for the fan-out child builds (the _CMMFanoutChild guard) to prevent recursion. -->
    <CMMDeployAll Condition="'$(CMMDeployAll)' == '' And '$(_CMMFanoutChild)' == 'true'">false</CMMDeployAll>
    <CMMDeployAll Condition="'$(CMMDeployAll)' == ''">true</CMMDeployAll>
  </PropertyGroup>

  <!-- The Steam install tracks the CURRENT release; it is 3.2.0 b9 today. Steam upgrades
       in place, so each release replaces the last and there is no 3.0 or 3.1 install left
       to build against — the version name here just follows the Steam copy. Decompiled
       sources for reference live in H:\_Games\7D2DAssembly - 3.2. -->
  <PropertyGroup Condition="'$(GameVersion)' == '3.2.0 b9'">
    <GameInstallDir>C:\_Games\Steam\steamapps\common\7 Days To Die</GameInstallDir>
    <GameVersionDefine>GV_V3</GameVersionDefine>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GameVersion)' == '2.6 b12'">
    <GameInstallDir>H:\_Games\7 Days To Die - 2.6 b12</GameInstallDir>
    <GameVersionDefine>GV_V26</GameVersionDefine>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GameVersion)' == 'Alpha 20.7 b1'">
    <GameInstallDir>H:\_Games\7 Days To Die - Alpha 20.7 b1</GameInstallDir>
    <GameVersionDefine>GV_A20</GameVersionDefine>
    <!-- Alphas ship 0Harmony in Managed, not Mods\0_TFP_Harmony. -->
    <HarmonyHintPath>$(GameInstallDir)\7DaysToDie_Data\Managed\0Harmony.dll</HarmonyHintPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GameVersion)' == 'Alpha 21.2 b37'">
    <GameInstallDir>H:\_Games\7 Days To Die - Alpha 21.2 b37</GameInstallDir>
    <GameVersionDefine>GV_A21</GameVersionDefine>
    <!-- Alphas ship 0Harmony in Managed, not Mods\0_TFP_Harmony. -->
    <HarmonyHintPath>$(GameInstallDir)\7DaysToDie_Data\Managed\0Harmony.dll</HarmonyHintPath>
  </PropertyGroup>

  <!-- Paths derived from the selected install root. -->
  <PropertyGroup>
    <GameManagedDir>$(GameInstallDir)\7DaysToDie_Data\Managed</GameManagedDir>
    <GameModsDir>$(GameInstallDir)\Mods</GameModsDir>
    <!-- 0Harmony ships under Mods\0_TFP_Harmony in 1.0+/2.x/3.x. Older alphas may store
         it elsewhere or not ship it — override with -p:HarmonyHintPath=...\0Harmony.dll. -->
    <HarmonyHintPath Condition="'$(HarmonyHintPath)' == ''">$(GameModsDir)\0_TFP_Harmony\0Harmony.dll</HarmonyHintPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <!-- Debug deploys straight into the selected game's own Mods folder for live testing. -->
    <OutputPath>$(GameModsDir)\ContextMusicManager\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <!-- Release stages to a CLEAN, version-agnostic folder (never the live game/music
         dirs) so the packaged zip contains only the mod, not your music library. The
         whole staging root is wiped in BeforeBuild, so the parent holds only this folder
         and the zip only ever carries this build. -->
    <OutputPath>$(MSBuildProjectDirectory)\dist\staging\ContextMusicManager\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>3</WarningLevel>
    <AbsoluteOutputPath>$(OutputPath)</AbsoluteOutputPath>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'CI|AnyCPU' ">
    <OutputPath>bin\CI\</OutputPath>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <!-- In-game context HUD (Alt+Numpad8) compiles in only when CMM_DEBUG_HUD is
       defined. ON for every configuration now, Release included: it stays hidden
       until the key is pressed and only reads engine state, so it costs a shipped
       player nothing, and it is the one tool that answers "why is THIS playing?"
       without reading a log. Build with -p:EnableDebugHud=false to strip it. -->
  <PropertyGroup>
    <EnableDebugHud Condition="'$(EnableDebugHud)' == ''">true</EnableDebugHud>
    <DefineConstants Condition="'$(EnableDebugHud)' == 'true'">$(DefineConstants);CMM_DEBUG_HUD</DefineConstants>
  </PropertyGroup>
  <!-- Per-version compile symbol (GV_V3 / GV_V26 / GV_A20 / GV_A21) so source can
       #if-guard APIs that differ across game versions (e.g. the Dynamic Music System
       does not exist before 1.0). -->
  <PropertyGroup>
    <DefineConstants Condition="'$(GameVersionDefine)' != ''">$(DefineConstants);$(GameVersionDefine)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Localization SHIPS AGAIN, under BOTH names, and the exclusion below is gone with it.
         It was excluded because the file was leftover template junk from another mod
         (crosshair/weapons keys) that 7DTD auto-loads; it now holds exactly two rows, renaming
         the two blocks the mod makes craftable so they read as "Speaker" and "Ham Radio" rather
         than "Electronics Store Book Shelf Speaker". The reason for the original exclusion was
         the CONTENT, not the mechanism: a file the game auto-loads is only dangerous when nobody
         has read it.
         TWO IDENTICAL FILES ON PURPOSE. 3.x reads Config/Localization.csv
         (Localization.LoadPatchDictionaries); A20, A21 and 2.6 all read Config/Localization.txt.
         Shipping only the .txt is why the rename did nothing on 3.2 and the speaker kept its
         full name. One payload goes to all four installs, so it carries both. -->
    <!-- The recorded dial sounds. CopyToOutputDirectory is NOT optional here: without it
         the Content item declares the files without staging them, so Debug got them only
         because DeployConfig force-copies Sounds\ separately, and the RELEASE ZIP
         SHIPPED WITHOUT THEM — a documented 1.0.5 feature ("swap them for anything you
         like") where the files were not there to swap. It failed quietly, too: a missing
         sound falls back to the synthesized click by design, so the radio still worked. -->
    <Content Include="Sounds\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- settings.xml and radio.xml are NOT shipped: CMM writes them at first run and
         backfills what later versions add (see Harmony/CMMSettingsFile.cs). Shipping them
         is what used to reset every user setting on update.
         They are not in the repo either, so these Excludes match nothing today. They stay
         as a guard: dropping a settings.xml into Config/ while debugging is an easy thing
         to do, and without them the wildcard would package it silently. -->
    <Content Include="Config\**\*" Exclude="Config\settings.xml;Config\radio.xml;Config\contexts.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Embed the canonical default context.lua so a missing or corrupt on-disk copy
         falls back to a tamper-proof baseline compiled into the DLL (ScriptHost tier 2).
         The same file is also copied to Config/ (above) as the user-editable copy, so
         there is exactly one source of truth. LogicalName keeps the resource id stable. -->
    <EmbeddedResource Include="Config\context.lua">
      <LogicalName>context.lua</LogicalName>
    </EmbeddedResource>
    <Content Include="THIRD_PARTY_NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Native decode shim (libopusfile + libvorbisfile + dr_flac/mp3/wav behind a thin C ABI).
         Deployed next to the mod DLL; NativeOpus.Preload(ModPath) LoadLibrary's it by full
         path at init. Windows x64 today; per-OS builds (.dylib/.so) added here later.
         REQUIRED for ALL formats — there is no managed fallback; a missing binary
         means no audio plays. -->
    <Content Include="CMM_Decoder\dist\CMM_Decoder.dll">
      <!-- MUST live in a SUBFOLDER, not the mod root: the game's Mod.LoadAssemblies()
           does GetFiles(modRoot) (top-dir only) and Assembly.LoadFrom()s every *.dll it
           finds. A native DLL at the root throws "Invalid Image" and aborts the WHOLE mod
           load. GetFiles isn't recursive, so Libs\ is never scanned. The Link path
           places it at OutputPath\Libs\CMM_Decoder.dll; Preload LoadLibrary's it by full
           path from there. -->
      <Link>Libs\CMM_Decoder.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Compile Include="Harmony\CMMConfigLoader.cs" />
    <Compile Include="Harmony\CMMSettingsSchema.cs" />
    <Compile Include="Harmony\ResumePolicy.cs" />
