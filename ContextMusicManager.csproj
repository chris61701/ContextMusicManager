  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- BeforeBuild/AfterBuild MUST be declared AFTER the targets import, or the SDK's empty
       defaults (imported later) override them and they silently never run. -->
  <Target Name="BeforeBuild">
    <!-- Make sure the deploy target exists (Alpha installs don't ship a Mods folder). -->
    <MakeDir Condition="'$(Configuration)' == 'Debug'" Directories="$(GameModsDir)" />
    <!-- Release: wipe the ENTIRE staging root so the zip never carries stale files
         (including leftover per-version staging dirs from older builds). Staging is
         build-generated and holds no music, so a full wipe is safe here. -->
    <RemoveDir Condition="'$(Configuration)' == 'Release'" Directories="$(MSBuildProjectDirectory)\dist\staging" />
    <!-- Debug: clean ONLY stale build artifacts from the deploy dir. Never wipe the
         whole directory in case anything else lives alongside it. -->
    <ItemGroup>
      <_StaleArtifacts Include="$(OutputPath)*.dll;$(OutputPath)*.pdb;$(OutputPath)*.dll.config" />
    </ItemGroup>
    <Delete Condition="'$(Configuration)' == 'Debug'" Files="@(_StaleArtifacts)" />
  </Target>
  <!-- Scaffold the Music library folder tree from the context definitions so a fresh
       install has a drop-in folder for every context (including the Music root). Reads
       the name+path attributes straight from Config/contexts.xml — the same list the mod
       loads at runtime — so the two never drift. Each folder gets a placeholder named
       after the context that maps to it (e.g. combat/ -> .Combat_Low) so the empty
       drop-in tree survives mod managers (e.g. Vortex) that strip empty folders, and the
       filename tells you which context the folder feeds.

       Purely additive: only creates missing directories and writes the placeholder. It
       never deletes, empties, or overwrites an existing folder, and it never touches the
       audio files inside one. Safe to run on every build over a populated library. -->
  <!-- Inline task: reads name+path from the SAME Context node (just like the runtime
       loader) so the placeholder filename can be the context name. A plain XmlPeek can
       only pull one attribute at a time and gives no way to pair a path with its name. -->

  <Target Name="CreateMusicContextFolders" AfterTargets="Build"
          Condition=" '$(Configuration)' == 'Release' And Exists('Config\contexts.xml') ">
  </Target>

  <!-- Fail fast on a bad/unknown -p:GameVersion before the compiler emits a wall of
       'type not found' errors from missing game assemblies. -->
  <Target Name="ValidateGameVersion" BeforeTargets="Build">
    <Error Condition="'$(GameInstallDir)' == ''"
           Text="Unknown GameVersion '$(GameVersion)'. Valid values: '3.2.0 b9', '2.6 b12', 'Alpha 20.7 b1', 'Alpha 21.2 b37'." />
    <Error Condition="!Exists('$(GameManagedDir)')"
           Text="Game Managed folder not found for GameVersion '$(GameVersion)': $(GameManagedDir)" />
    <Warning Condition="!Exists('$(HarmonyHintPath)')"
             Text="0Harmony.dll not found at $(HarmonyHintPath) — override with -p:HarmonyHintPath=... if this version stores it elsewhere." />
    <Message Importance="high" Text="[CMM] Building '$(Configuration)' against GameVersion '$(GameVersion)' ($(GameInstallDir))" />
  </Target>

  <!-- Debug only: deploy the developer override file and point it at the personal music
       library. There is no committed Config/settings.xml any more — CMM generates that at
       first run — so the dev values live in build/settings.dev.xml, which is read FIRST in
       CMM's settings chain and therefore shadows the generated file without touching it.
       Only MusicPath is rewritten here, so the repo can never ship a machine-specific path. -->
  <Target Name="SetDebugSettings" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug'">
    <!-- NO RemoveDir here any more. The deployed Config now contains files CMM OWNS —
         settings.xml and radio.xml, which it generates and backfills — and wiping the
         folder every build destroyed them along with anything the mod had persisted
         (the Alt+Home combat-music toggle, most visibly). The repo files below are still
         force-copied so structural changes propagate; only orphan cleanup is lost, which
         is worth it. -->
    <ItemGroup>
      <_DebugCfg Include="Config\**\*"
                 Exclude="Config\settings.xml;Config\radio.xml;Config\contexts.xml" />
      <_DebugSnd Include="Sounds\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DebugCfg)"
          DestinationFiles="@(_DebugCfg->'$(OutputPath)Config\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_DebugSnd)"
          DestinationFiles="@(_DebugSnd->'$(OutputPath)Sounds\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <!-- Dev overrides go in their OWN file at the front of CMM's settings chain, instead
         of being poked into the deployed settings.xml. That file is CMM's to write now,
         and editing it here would fight the generator and clobber persisted settings. -->
    <Copy SourceFiles="build\settings.dev.xml"
          DestinationFiles="$(OutputPath)Config\settings.dev.xml"
          SkipUnchangedFiles="false" />
    <XmlPoke XmlInputPath="$(OutputPath)Config\settings.dev.xml"
             Query="/CMMSettings/MusicPath" Value="$(DebugMusicPath)" />
    <Message Importance="high"
             Text="[CMM] Debug deploy — settings.dev.xml overrides: MusicPath=$(DebugMusicPath), DebugLogging=true, PerfTiming=true, Ctrl gate off" />
  </Target>

  <!-- Release only: zip the staged mod as
       'ContextMusicManager V<modversion> for A20-A21-2.6-3.2.zip' under dist\ — ONE
       cross-version artifact. The version list is spelled out (NOT a range like A20-3.2)
       to make explicit that 1.x is NOT supported. Runs after the Music scaffold target
       so the empty drop-in tree is included. The mod version is read from ModInfo.xml
       (its authoritative source). -->
  <Target Name="PackageRelease" AfterTargets="CreateMusicContextFolders"
          Condition="'$(Configuration)' == 'Release'">
    <XmlPeek XmlInputPath="ModInfo.xml" Query="/xml/Version/@value">
      <Output TaskParameter="Result" ItemName="_ModVersionItem" />
    </XmlPeek>
    <PropertyGroup>
      <_ModVersion>@(_ModVersionItem)</_ModVersion>
      <_StageParent>$(MSBuildProjectDirectory)\dist\staging</_StageParent>
      <!-- A RELEASE-CANDIDATE LABEL THAT ONLY NAMES THE FILE.
           ModInfo's Version has to stay parseable by System.Version or the 3.x loader warns
           "does not define a valid Version" in every tester's log, so the old way of marking a
           candidate (writing 1.0.5RC3 into ModInfo) bought a filename at the cost of a warning
           in the very build being tested. This never touches ModInfo:
               msbuild -p:Configuration=Release -p:RcLabel=RC5
           gives 'ContextMusicManager V1.0.5RC5 for ...zip' with ModInfo still saying 1.0.5. -->
      <_ZipPath>$(MSBuildProjectDirectory)\dist\ContextMusicManager V$(_ModVersion)$(RcLabel) for A20-A21-2.6-3.2.zip</_ZipPath>
    </PropertyGroup>
    <Delete Files="$(_ZipPath)" />
    <!-- SourceDirectory is the parent of ContextMusicManager\, so the folder itself
         becomes the top-level entry in the zip (extracts straight into Mods\). -->
    <ZipDirectory SourceDirectory="$(_StageParent)" DestinationFile="$(_ZipPath)" Overwrite="true" />
    <Message Importance="high" Text="[CMM] Packaged $(_ZipPath)" />
  </Target>

  <!-- All targetable game versions, in one place. Used by DeployAll (and DebugFanout)
       to fan a Debug build/deploy out across every install for compile-testing. Keep in
       sync with the GameVersion PropertyGroups near the top. -->
  <ItemGroup>
    <CMMGameVersions Include="3.2.0 b9" />
    <CMMGameVersions Include="2.6 b12" />
    <CMMGameVersions Include="Alpha 21.2 b37" />
    <CMMGameVersions Include="Alpha 20.7 b1" />
  </ItemGroup>

  <!-- Build + deploy the Debug mod into EVERY game install's Mods folder for testing:
         dotnet msbuild ContextMusicManager.csproj -t:DeployAll
       Each version compiles against its own assemblies (with its GV_* symbol) and
       deploys to that install's Mods\ContextMusicManager, with MusicPath repointed to
       the personal library. Runs them in sequence via the MSBuild task so each is a
       clean per-version build (different references + DefineConstants force a recompile). -->
  <Target Name="DeployAll">
    <Message Importance="high" Text="[CMM] DeployAll — building Debug for all versions: @(CMMGameVersions)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="Configuration=Debug;GameVersion=%(CMMGameVersions.Identity);_CMMFanoutChild=true" />
    <Message Importance="high" Text="[CMM] DeployAll complete — deployed to all game Mods folders." />
  </Target>

  <!-- Make a plain Debug build (e.g. the VS Build button / Ctrl+Shift+B, which runs Build
       with no explicit target) deploy to EVERY install, not just the selected GameVersion.
       The in-process build already compiled+deployed its own version; here we fan out to
       the OTHER versions by COPYING that finished payload into each install's Mods folder.
       This is valid because divergent game-API members are bound by name via reflection
       (see ContextResolver's version bridges), so one compiled DLL runs on all four. The
       ONE #if GV_V3 fork (the world-emitter radio, 3.x-only) IS included in this payload —
       it's built against the default GameVersion (3.x) — and self-disables at runtime on
       older games via EmitterCompat.RuntimeSupported (with the TEFeatureDoor Harmony hook
       resolved by NAME, since that type doesn't exist pre-1.0 and a hard token would abort
       PatchAll on A20/A21). Copying
       instead of recompiling makes a full four-install deploy near-instant for testing.
       The payload is now fully uniform across installs — ModInfo.xml is a single
       dual-format file that A20 and A21/2.x/3.x both accept (see its header), so there
       is no per-version file to re-apply.
       _CMMFanoutChild=true on the children sets CMMDeployAll=false, so they don't re-fan
       and recurse. Disable the whole thing with -p:CMMDeployAll=false. For an authoritative
       per-version RECOMPILE of every install (e.g. to verify a build actually compiles
       against each game's assemblies), use -t:DeployAll instead. -->
  <Target Name="DebugFanout" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And '$(CMMDeployAll)' == 'true'">
    <Message Importance="high" Text="[CMM] Debug fan-out — copying '$(GameVersion)' payload to other installs: @(CMMGameVersions)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="CopyDeploy"
             Condition="'%(CMMGameVersions.Identity)' != '$(GameVersion)'"
             Properties="Configuration=Debug;GameVersion=%(CMMGameVersions.Identity);_CMMFanoutChild=true;_CMMCopyFrom=$(OutputPath)" />
    <Message Importance="high" Text="[CMM] Debug fan-out complete — copied to all game Mods folders." />
  </Target>

  <!-- Copy a pre-built Debug payload from _CMMCopyFrom into THIS version's Mods folder
       (evaluated per-version: GameModsDir/OutputPath resolve from the child's GameVersion).
       Used by DebugFanout to deploy the same DLL to every install without recompiling.
       Stale build artifacts are cleared first so nothing orphaned lingers. Config is NOT
       cleared: it now holds files CMM owns and generates (settings.xml, radio.xml), and
       each install's copy is that install's state. The mod folder otherwise holds only our
       deployed files (the music library lives at MusicPath, elsewhere), so this never
       touches music. -->
  <Target Name="CopyDeploy" Condition="'$(_CMMCopyFrom)' != ''">
    <Error Condition="!Exists('$(_CMMCopyFrom)')" Text="CopyDeploy: source payload not found at '$(_CMMCopyFrom)'." />
    <MakeDir Directories="$(GameModsDir)" />
    <ItemGroup>
      <_StaleDeployed Include="$(OutputPath)*.dll;$(OutputPath)*.pdb;$(OutputPath)*.dll.config" />
      <_CopyPayload Include="$(_CMMCopyFrom)**\*" />
    </ItemGroup>
    <Delete Files="@(_StaleDeployed)" />
    <Copy SourceFiles="@(_CopyPayload)"
          DestinationFiles="@(_CopyPayload->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="[CMM] Copied payload to '$(GameVersion)' ($(OutputPath))" />
  </Target>

  <!-- Package the single cross-version Release zip in one step, regardless of the
       currently-active Configuration:
         dotnet msbuild ContextMusicManager.csproj -t:Package
       One compiled DLL runs on every supported game version, so this produces exactly
       ONE artifact: dist\ContextMusicManager V<ver> for A20-A21-2.6-3.2.zip. It MUST build
       against the default GameVersion (3.x): the world-emitter radio is #if GV_V3, so a
       DLL built against any other version would silently ship WITHOUT that feature.
       (Including it is always safe — it runtime-disables itself on pre-3.0 games via
       EmitterCompat.RuntimeSupported.) -->
  <Target Name="Package">
    <Message Importance="high" Text="[CMM] Package — building the single cross-version Release zip." />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="Configuration=Release" />
    <Message Importance="high" Text="[CMM] Package complete — zip in dist\." />
  </Target>
</Project>