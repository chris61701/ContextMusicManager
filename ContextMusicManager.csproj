         fans out to EVERY game install via the DebugFanout target below, so all four
         Mods folders stay in sync. Override with -p:CMMDeployAll=false for a quick
         single-version build into just the selected GameVersion's install. Always false
         for the fan-out child builds (the _CMMFanoutChild guard) to prevent recursion. -->
    <CMMDeployAll Condition="'$(CMMDeployAll)' == '' And '$(_CMMFanoutChild)' == 'true'">false</CMMDeployAll>
    <CMMDeployAll Condition="'$(CMMDeployAll)' == ''">true</CMMDeployAll>
  </PropertyGroup>

