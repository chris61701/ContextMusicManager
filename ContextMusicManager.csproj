  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- BeforeBuild/AfterBuild MUST be declared AFTER the targets import, or the SDK's empty
       defaults (imported later) override them and they silently never run. -->
  <Target Name="BeforeBuild">
    <!-- Make sure the deploy target exists (Alpha installs don't ship a Mods folder). -->
    <MakeDir Condition="'$(Configuration)' == 'Debug'" Directories="$(GameModsDir)" />
    <!-- Release: wipe the per-version staging dir so the zip never carries stale files.
         Staging is build-generated and holds no music, so a full wipe is safe here. -->
    <RemoveDir Condition="'$(Configuration)' == 'Release'" Directories="$(OutputPath)" />
    <!-- Debug: clean ONLY stale build artifacts from the deploy dir. Never wipe the
         whole directory in case anything else lives alongside it. -->
    <ItemGroup>
      <_StaleArtifacts Include="$(OutputPath)*.dll;$(OutputPath)*.pdb;$(OutputPath)*.dll.config" />
    </ItemGroup>
    <Delete Condition="'$(Configuration)' == 'Debug'" Files="@(_StaleArtifacts)" />
  </Target>
  <Target Name="AfterBuild" Condition=" '$(Configuration)' != 'CI' ">
    <!-- ModInfo.xml is authoritative: it ships verbatim (copied via the Content item
         above), so its values are edited directly in the source file, not rewritten here. -->
    <!-- Old-style projects don't auto-copy netstandard.dll the way SDK-style projects do,
         so this Delete is a no-op in practice — kept as a safeguard in case the toolchain
         ever starts producing it for non-A20 targets where it is not needed. -->
    <Delete Condition="'$(GameVersionDefine)' != 'GV_A20'" Files="$(OutputPath)netstandard.dll" />
  </Target>

  <!-- A20 only: copy the runtime netstandard.dll type-forwarding shim into the mod folder.
       A20 runs on Unity 2020.3 whose Mono has no netstandard.dll in Managed; without it
       the netstandard2.0 NAudio sub-assemblies (NAudio.Core, NAudio.Vorbis, etc.) throw
       ReflectionTypeLoadException and Harmony never patches.  All newer game targets ship
       a Mono that handles netstandard2.0 natively, so they don't need this file.
       This project is old-style (ToolsVersion 12.0) and does not auto-copy netstandard.dll
       the way SDK-style projects do, so we copy it explicitly here.
       Default source: dotnet CLI Build.Extensions (net461 variant, MIT licensed).
       Override with -p:NetStandardShimDll=<path> when building with VS MSBuild. -->
  <PropertyGroup Condition="'$(GameVersionDefine)' == 'GV_A20'">
    <NetStandardShimDll Condition="'$(NetStandardShimDll)' == ''">$(MSBuildExtensionsPath)\Microsoft\Microsoft.NET.Build.Extensions\net461\lib\netstandard.dll</NetStandardShimDll>
  </PropertyGroup>
  <Target Name="CopyNetStandardShimForA20" AfterTargets="AfterBuild"
          Condition="'$(GameVersionDefine)' == 'GV_A20' And '$(Configuration)' != 'CI'">
    <Warning Condition="!Exists('$(NetStandardShimDll)')"
             Text="[CMM] netstandard.dll shim not found at '$(NetStandardShimDll)'. A20 NAudio will fail to load. Override with -p:NetStandardShimDll=&lt;path&gt;." />
    <Copy SourceFiles="$(NetStandardShimDll)" DestinationFolder="$(OutputPath)"
          Condition="Exists('$(NetStandardShimDll)')"
          SkipUnchangedFiles="true" />
    <Message Condition="Exists('$(NetStandardShimDll)')" Importance="high"
             Text="[CMM] Copied netstandard.dll shim for A20 from $(NetStandardShimDll)" />
  </Target>

  <!-- A20 only: overwrite the deployed ModInfo.xml with the legacy nested-<ModInfo> format
       (A20 expects <xml> root wrapping a <ModInfo> element; the modern format flattens the
       fields directly under <xml>). Runs after the normal content copy. The Version is
       synced from the authoritative ModInfo.xml so the two never drift. -->
  <Target Name="DeployLegacyModInfo" AfterTargets="Build"
          Condition="'$(LegacyModInfo)' == 'true' And '$(Configuration)' != 'CI'">
    <XmlPeek XmlInputPath="ModInfo.xml" Query="/xml/Version/@value">
      <Output TaskParameter="Result" ItemName="_AuthoredVersion" />
    </XmlPeek>
    <Copy SourceFiles="ModInfo.A20.xml" DestinationFiles="$(OutputPath)ModInfo.xml"
          SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <XmlPoke XmlInputPath="$(OutputPath)ModInfo.xml" Query="/xml/ModInfo/Version/@value"
             Value="@(_AuthoredVersion)" />
    <Message Importance="high" Text="[CMM] A20 legacy ModInfo deployed (Version @(_AuthoredVersion))" />
  </Target>
  <!-- Scaffold the Music library folder tree from the context definitions so a fresh
       install has a drop-in folder for every context (including the Music root). Reads
       the name+path attributes straight from Config/contexts.xml — the same list the mod
       loads at runtime — so the two never drift. Each folder gets a placeholder named
       after the context that maps to it (e.g. combat/ -> .Combat_Low) so the empty
       drop-in tree survives mod managers (e.g. Vortex) that strip empty folders, and the
       filename tells you which context the folder feeds.

       Purely additive: only creates missing directories and writes the placeholder. It
       never deletes, empties, or overwrites an existing folder, and it never touches the
       audio files inside one. Safe to run on every build over a populated library. -->
  <!-- Inline task: reads name+path from the SAME Context node (just like the runtime
       loader) so the placeholder filename can be the context name. A plain XmlPeek can
       only pull one attribute at a time and gives no way to pair a path with its name. -->
  <UsingTask TaskName="ScaffoldMusicFolders" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ContextsXml ParameterType="System.String" Required="true" />
      <MusicRoot   ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Xml" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        const string note = "Placeholder so mod managers don't delete this empty folder. Drop your music files here (you can delete this file once you do).";
        var doc = new XmlDocument();
        doc.Load(ContextsXml);
        Directory.CreateDirectory(MusicRoot);
        foreach (XmlNode node in doc.DocumentElement.ChildNodes)
        {
            if (node.NodeType != XmlNodeType.Element || node.Name != "Context") continue;
            var el = (XmlElement)node;
            string name = el.GetAttribute("name");
            string path = el.GetAttribute("path");
            // Skip sentinels (empty path) and any unnamed node — same as the loader.
            if (string.IsNullOrEmpty(name) || string.IsNullOrEmpty(path)) continue;
            string dir = Path.Combine(MusicRoot, path.Replace('/', Path.DirectorySeparatorChar)
                                                     .Replace('\\', Path.DirectorySeparatorChar));
            Directory.CreateDirectory(dir);
            // Placeholder named after the context that maps here (e.g. .Combat_Low),
            // so a glance at the folder tells you which context it feeds. The audio
            // scanner ignores non-audio extensions, so the dotfile is inert.
            File.WriteAllText(Path.Combine(dir, "." + name), note);
        }
        Log.LogMessage(MessageImportance.High,
            "[CMM] Ensured Music context folders (with .<context> placeholders) under " + MusicRoot);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CreateMusicContextFolders" AfterTargets="Build"
          Condition=" '$(Configuration)' == 'Release' And Exists('Config\contexts.xml') ">
    <ScaffoldMusicFolders ContextsXml="Config\contexts.xml" MusicRoot="$(OutputPath)Music" />
  </Target>

  <!-- Fail fast on a bad/unknown -p:GameVersion before the compiler emits a wall of
       'type not found' errors from missing game assemblies. -->
  <Target Name="ValidateGameVersion" BeforeTargets="Build">
    <Error Condition="'$(GameInstallDir)' == ''"
           Text="Unknown GameVersion '$(GameVersion)'. Valid values: '3.0.0 b259', '2.6 b12', 'Alpha 20.7 b1', 'Alpha 21.2 b37'." />
    <Error Condition="!Exists('$(GameManagedDir)')"
           Text="Game Managed folder not found for GameVersion '$(GameVersion)': $(GameManagedDir)" />
    <Warning Condition="!Exists('$(HarmonyHintPath)')"
             Text="0Harmony.dll not found at $(HarmonyHintPath) — override with -p:HarmonyHintPath=... if this version stores it elsewhere." />
    <Message Importance="high" Text="[CMM] Building '$(Configuration)' against GameVersion '$(GameVersion)' ($(GameInstallDir))" />
  </Target>

  <!-- Debug only: point the DEPLOYED settings.xml at the personal music library.
       The committed Config/settings.xml keeps the release value ("Music"), so the
       repo can never accidentally ship a machine-specific path. -->
  <Target Name="SetDebugSettings" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug'">
    <!-- Guarantee the deployed Config is an EXACT mirror of the repo on every Debug build:
         wipe it (dropping any renamed/removed files) then re-copy with an explicit Copy.
         This bypasses the normal CopyToOutputDirectory path, which MSBuild can skip as
         "up-to-date" on incremental builds and which never removes orphaned files — so
         structural changes to settings.xml/contexts.xml always propagate. Config holds
         only repo XML; the music library lives at MusicPath, not here, so wiping is safe. -->
    <RemoveDir Directories="$(OutputPath)Config" />
    <ItemGroup>
      <_DebugCfg Include="Config\**\*" Exclude="Config\Localization.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(_DebugCfg)"
          DestinationFiles="@(_DebugCfg->'$(OutputPath)Config\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <!-- Then point at the personal library and enable verbose logging for testing.
         The committed settings.xml keeps the release values (Music / DebugLogging=false). -->
    <XmlPoke XmlInputPath="$(OutputPath)Config\settings.xml"
             Query="/CMMSettings/MusicPath" Value="$(DebugMusicPath)" />
    <XmlPoke XmlInputPath="$(OutputPath)Config\settings.xml"
             Query="/CMMSettings/DebugLogging" Value="true" />
    <Message Importance="high"
             Text="[CMM] Debug deploy — Config mirrored; MusicPath=$(DebugMusicPath), DebugLogging=true" />
  </Target>

  <!-- Release only: zip the staged mod as
       'ContextMusicManager V<modversion> for <gameversion>.zip' under dist\.
       Runs after the Music scaffold target so the empty drop-in tree is included.
       The mod version is read from ModInfo.xml (its authoritative source). -->
  <Target Name="PackageRelease" AfterTargets="CreateMusicContextFolders"
          Condition="'$(Configuration)' == 'Release'">
    <XmlPeek XmlInputPath="ModInfo.xml" Query="/xml/Version/@value">
      <Output TaskParameter="Result" ItemName="_ModVersionItem" />
    </XmlPeek>
    <PropertyGroup>
      <_ModVersion>@(_ModVersionItem)</_ModVersion>
      <_StageParent>$(MSBuildProjectDirectory)\dist\staging\$(GameVersion)</_StageParent>
      <_ZipPath>$(MSBuildProjectDirectory)\dist\ContextMusicManager V$(_ModVersion) for $(GameVersion).zip</_ZipPath>
    </PropertyGroup>
    <Delete Files="$(_ZipPath)" />
    <!-- SourceDirectory is the parent of ContextMusicManager\, so the folder itself
         becomes the top-level entry in the zip (extracts straight into Mods\). -->
    <ZipDirectory SourceDirectory="$(_StageParent)" DestinationFile="$(_ZipPath)" Overwrite="true" />
    <Message Importance="high" Text="[CMM] Packaged $(_ZipPath)" />
  </Target>

  <!-- All targetable game versions, in one place. Used by DeployAll / PackageAll to
       fan a build out across every install. Keep in sync with the GameVersion
       PropertyGroups near the top. -->
  <ItemGroup>
    <CMMGameVersions Include="3.0.0 b259" />
    <CMMGameVersions Include="2.6 b12" />
    <CMMGameVersions Include="Alpha 21.2 b37" />
    <CMMGameVersions Include="Alpha 20.7 b1" />
  </ItemGroup>

  <!-- Build + deploy the Debug mod into EVERY game install's Mods folder for testing:
         dotnet msbuild ContextMusicManager.csproj -t:DeployAll
       Each version compiles against its own assemblies (with its GV_* symbol) and
       deploys to that install's Mods\ContextMusicManager, with MusicPath repointed to
       the personal library. Runs them in sequence via the MSBuild task so each is a
       clean per-version build (different references + DefineConstants force a recompile). -->
  <Target Name="DeployAll">
    <Message Importance="high" Text="[CMM] DeployAll — building Debug for all versions: @(CMMGameVersions)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="Configuration=Debug;GameVersion=%(CMMGameVersions.Identity);_CMMFanoutChild=true" />
    <Message Importance="high" Text="[CMM] DeployAll complete — deployed to all game Mods folders." />
  </Target>

  <!-- Make a plain Debug build (e.g. the VS Build button, which runs Build with no
       explicit target) deploy to EVERY install, not just the selected GameVersion.
       The in-process build already compiled+deployed its own version; here we fan out
       to the OTHER versions, each as its own clean per-version build (different game
       references + GV_* symbol force a recompile — you can't copy one DLL to all four).
       _CMMFanoutChild=true on the children sets CMMDeployAll=false, so they don't
       re-fan and recurse. Disable the whole thing with -p:CMMDeployAll=false. -->
  <Target Name="DebugFanout" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And '$(CMMDeployAll)' == 'true'">
    <Message Importance="high" Text="[CMM] Debug fan-out from '$(GameVersion)' to other installs: @(CMMGameVersions)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Condition="'%(CMMGameVersions.Identity)' != '$(GameVersion)'"
             Properties="Configuration=Debug;GameVersion=%(CMMGameVersions.Identity);_CMMFanoutChild=true" />
    <Message Importance="high" Text="[CMM] Debug fan-out complete — deployed to all game Mods folders." />
  </Target>

  <!-- Package release zips for every version in one go:
         dotnet msbuild ContextMusicManager.csproj -t:PackageAll -->
  <Target Name="PackageAll">
    <Message Importance="high" Text="[CMM] PackageAll — Release zips for all versions: @(CMMGameVersions)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="Configuration=Release;GameVersion=%(CMMGameVersions.Identity)" />
    <Message Importance="high" Text="[CMM] PackageAll complete — zips in dist\." />
  </Target>
</Project>